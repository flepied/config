Host *
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/ssh_control_%h_%p_%r
  ControlPersist 5m
  ForwardAgent yes

Host d development
    Hostname bastion.development.wazo.cloud
    Port 22000
    User flepied

Host *.development.wazo.cloud *.development.wazo 172.20.* !bastion.development.wazo.cloud
    ProxyJump development
    User flepied
    StrictHostKeyChecking no
    UserKnownHostsFile=/dev/null

Host s staging
    Hostname bastion.staging.wazo.cloud
    Port 22000
    User flepied

Host *.staging.wazo.cloud *.staging.wazo 172.25.* !bastion.staging.wazo.cloud
    ProxyJump staging
    User flepied

Host p production
    Hostname bastion.production.wazo.cloud
    Port 22000
    User flepied

Host *.production.wazo.cloud *.production.wazo 172.30.* !bastion.production.wazo.cloud
    ProxyJump production
    User flepied

# githubPersonal
Host githubperso
   HostName github.com
   User git
   IdentityFile ~/.ssh/id_flepied_gmail

Host bitbucket
   HostName bitbucket.org
   User git
