Host *
  Compression yes
  Cipher blowfish
  ControlMaster auto
  ControlPath ~/.ssh/ssh_control_%h_%p_%r
  ForwardAgent yes

Host d development
    Hostname bastion.development.wazo.cloud
    Port 22000
    User flepied
    StrictHostKeyChecking no
    UserKnownHostsFile=/dev/null
    ControlMaster auto
    ControlPath ~/.ssh/persist-development-%r@%h
    ControlPersist 5m

Host *.development.wazo.cloud *.development.wazo 172.20.*
    ProxyJump development
    User flepied
    StrictHostKeyChecking no
    UserKnownHostsFile=/dev/null

Host s staging
    Hostname bastion.staging.wazo.cloud
    Port 22000
    User flepied
    StrictHostKeyChecking no
    UserKnownHostsFile=/dev/null
    ControlMaster auto
    ControlPath ~/.ssh/persist-staging-%r@%h
    ControlPersist 5m

Host *.staging.wazo.cloud *.staging.wazo 172.25.*
    ProxyJump staging
    User flepied
    StrictHostKeyChecking no
    UserKnownHostsFile=/dev/null

Host p production
    Hostname bastion.production.wazo.cloud
    Port 22000
    User flepied
    StrictHostKeyChecking no
    UserKnownHostsFile=/dev/null
    ControlMaster auto
    ControlPath ~/.ssh/persist-production-%r@%h
    ControlPersist 5m

Host *.production.wazo.cloud *.production.wazo 172.30.*
    ProxyJump production
    User flepied
    StrictHostKeyChecking no
    UserKnownHostsFile=/dev/null

# githubPersonal
Host githubperso
   HostName github.com
   User git
   IdentityFile ~/.ssh/id_flepied_gmail
